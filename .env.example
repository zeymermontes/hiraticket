# Supabase — copy to .env.local and fill from your Supabase project
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Server-only key (used by admin/seed scripts; NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key

# Plugin credential encryption (AES-256-GCM). Encrypts third-party API keys/tokens that tenants
# store per plugin. Generate once with: openssl rand -hex 32
# Keep it STABLE — changing it makes existing encrypted plugin credentials undecryptable.
# If unset, the app falls back to SUPABASE_SERVICE_ROLE_KEY (so rotating that would break plugins).
PLUGIN_SECRET_KEY=YOUR-64-hex-char-random-key

# Message-body encryption at rest (AES-256-GCM with a per-tenant HKDF subkey). Encrypts
# messages.body and internal_messages.body. Generate once with: openssl rand -hex 32
# Keep it STABLE — changing it makes existing encrypted messages unreadable.
# MUST be set with the SAME value on the web service AND the Go worker (both encrypt/decrypt).
MESSAGE_SECRET_KEY=YOUR-64-hex-char-random-key

# MercadoPago Partner integrator id (Developers Partner Program). Optional — when set, every
# checkout preference carries x-integrator-id so tenants' volume counts toward our revenue share.
MP_INTEGRATOR_ID=dev_YOUR-integrator-id

# WhatsApp Cloud API webhook (official Tech Provider / Coexistence channel — separate from the
# whatsmeow worker). The endpoint lives at /api/whatsapp/webhook on the Next.js web service.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: a secret you invent (openssl rand -hex 16); paste the SAME value
#   into Meta → WhatsApp → Configuración → Webhooks → "Identificador de verificación".
# WHATSAPP_APP_SECRET: Meta app → Configuración → Básica → "Clave secreta de la app". Verifies the
#   X-Hub-Signature-256 signature on incoming events.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=htk_wh_YOUR-random-token
WHATSAPP_APP_SECRET=YOUR-meta-app-secret

# WhatsApp Embedded Signup (official Cloud API / coexistence onboarding). Both values are safe to
# expose client-side; the code→token exchange uses WHATSAPP_APP_SECRET (server-only).
#   NEXT_PUBLIC_FB_APP_ID:        your Meta app id (App dashboard → Configuración → Básica).
#   NEXT_PUBLIC_WA_ES_CONFIG_ID:  the Facebook Login for Business configuration id you create for
#                                 Embedded Signup (coexistence) in the Meta app dashboard.
NEXT_PUBLIC_FB_APP_ID=YOUR-meta-app-id
NEXT_PUBLIC_WA_ES_CONFIG_ID=YOUR-embedded-signup-config-id
# Comma-separated emails that see the official flow while it's in testing (existing users keep QR).
WA_OFFICIAL_EMAILS=

# Cloud API test credentials for the App Review demo panel (send message + create template).
#   WHATSAPP_CLOUD_TOKEN:            a System User token (or the temporary token from WhatsApp → API Setup).
#   WHATSAPP_TEST_PHONE_NUMBER_ID:   the Phone Number ID (WhatsApp → API Setup).
#   WHATSAPP_TEST_WABA_ID:           the WhatsApp Business Account ID (same screen).
WHATSAPP_CLOUD_TOKEN=YOUR-cloud-api-token
WHATSAPP_TEST_PHONE_NUMBER_ID=YOUR-phone-number-id
WHATSAPP_TEST_WABA_ID=YOUR-waba-id

# Public app URL — used for server-side auth redirects (logout, /auth/callback, invites) so they
# don't land on the internal localhost:PORT behind Render's proxy. Set on the host (no trailing /).
# IMPORTANT: use APP_URL (a RUNTIME var). NEXT_PUBLIC_* is inlined at build time, so setting it
# after a build reads as undefined on the server.
APP_URL=https://hiraticket.onrender.com

# Worker DB connection — use the Session pooler host (IPv4), NOT the direct db.* host.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-ref:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Resend — custom SMTP for Supabase Auth emails (see supabase/RESEND_SETUP.md).
# NOTE: with a hosted Supabase project you DON'T set this anywhere in the app — the
# Resend API key goes straight into the Supabase dashboard (Auth → Emails → SMTP).
# This var is ONLY for local Supabase CLI dev (config.toml pass = "env(...)").
# It does NOT belong in the web app's env or the Go worker's env.
RESEND_SMTP_PASSWORD=re_YOUR-resend-api-key

# --- Notificaciones push (Web Push / VAPID) ---
# Se generan UNA sola vez con:  npx web-push generate-vapid-keys --json
#
# NUNCA se rotan. La clave pública es la identidad del servidor ante el navegador: cambiarla
# invalida todas las suscripciones guardadas, y cada agente tendría que volver a activar el push
# en CADA uno de sus dispositivos (nadie se entera hasta que dejan de llegar avisos).
#
# La pública viaja al navegador (por eso NEXT_PUBLIC_). La privada firma los envíos y no sale del
# servidor jamás.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXXXX-clave-publica
VAPID_PRIVATE_KEY=clave-privada
# Contacto que Google/Apple/Mozilla usan si tu tráfico de push les causa problemas (mailto: o https:).
VAPID_SUBJECT=mailto:soporte@hiraticket.com

# Secreto compartido entre el worker de whatsmeow y /api/push/notify. El worker no firma VAPID por
# su cuenta a propósito: duplicaría el envío y la regla de a quién le toca cada aviso. Tiene que ser
# el MISMO valor en el servicio web y en el worker. Sin él, la ruta queda cerrada (no abierta).
PUSH_HOOK_SECRET=un-secreto-largo-aleatorio
